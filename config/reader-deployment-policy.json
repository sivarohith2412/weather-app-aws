{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateBoundedReaderRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::471084227270:role/weather-reader-dev-role",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::471084227270:policy/weather-reader-dev-boundary"
        }
      }
    },
    {
      "Sid": "ReaderApiInvokePermission",
      "Effect": "Allow",
      "Action": [
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy"
      ],
      "Resource": "arn:aws:lambda:us-east-2:471084227270:function:weather-reader-dev"
    },
    {
      "Sid": "ManageHttpApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PATCH",
        "apigateway:DELETE",
        "apigateway:PUT"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-2::/apis",
        "arn:aws:apigateway:us-east-2::/apis/*",
        "arn:aws:apigateway:us-east-2::/tags*"
      ]
    },
    {
      "Sid": "ManageReaderFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags",
        "lambda:GetRuntimeManagementConfig",
        "lambda:PutRuntimeManagementConfig",
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:DeleteFunctionEventInvokeConfig"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-2:471084227270:function:weather-reader-dev",
        "arn:aws:lambda:us-east-2:471084227270:function:weather-reader-dev:*"
      ]
    },
    {
      "Sid": "ManageReaderRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "arn:aws:iam::471084227270:role/weather-reader-dev-role"
    },
    {
      "Sid": "PassReaderRoleToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::471084227270:role/weather-reader-dev-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageReaderLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:TagLogGroup",
        "logs:UntagLogGroup",
        "logs:ListTagsLogGroup",
        "logs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:logs:us-east-2:471084227270:log-group:/aws/lambda/weather-reader-dev",
        "arn:aws:logs:us-east-2:471084227270:log-group:/aws/lambda/weather-reader-dev:*"
      ]
    },
    {
      "Sid": "CloudFormationStageTagging",
      "Effect": "Allow",
      "Action": [
        "apigateway:TagResource",
        "apigateway:UntagResource"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-2::/apis/*/stages",
        "arn:aws:apigateway:us-east-2::/apis/*/stages/*"
      ]
    }
  ]
}